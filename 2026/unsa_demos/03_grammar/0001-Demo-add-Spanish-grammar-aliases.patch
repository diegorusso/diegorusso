diff --git a/Lib/test/test_grammar.py b/Lib/test/test_grammar.py
index ebcd98a0a37..48d16561b7d 100644
--- a/Lib/test/test_grammar.py
+++ b/Lib/test/test_grammar.py
@@ -878,6 +878,14 @@ def g3():
         self.assertEqual(y, (1, 2, 3), "unparenthesized star expr return")
         check_syntax_error(self, "class foo:return 1")
 
+    def test_spanish_return_keyword(self):
+        namespace = {}
+        exec("def answer():\n    retornar 42", namespace)
+        self.assertEqual(namespace["answer"](), 42)
+
+        exec("def english_answer():\n    return 42", namespace)
+        self.assertEqual(namespace["english_answer"](), 42)
+
     def test_control_flow_in_finally(self):
 
         def run_case(self, src, expected):
@@ -1348,6 +1356,31 @@ def test_if(self):
         elif 0: pass
         else: pass
 
+    def test_spanish_if_keywords(self):
+        namespace = {}
+        exec("si True:\n    result = 'simple'", namespace)
+        self.assertEqual(namespace["result"], "simple")
+
+        exec("""
+si False:
+    result = "if"
+sinosi True:
+    result = "elif"
+else:
+    result = "else"
+""", namespace)
+        self.assertEqual(namespace["result"], "elif")
+
+        exec("""
+if False:
+    result = "if"
+elif True:
+    result = "elif"
+else:
+    result = "else"
+""", namespace)
+        self.assertEqual(namespace["result"], "elif")
+
     def test_while(self):
         # 'while' test ':' suite ['else' ':' suite]
         while 0: pass
